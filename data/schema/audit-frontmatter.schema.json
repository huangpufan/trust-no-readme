{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/huangpufan/trust-no-readme/data/schema/audit-frontmatter.schema.json",
  "title": "trust-no-readme Audit Snapshot Frontmatter",
  "type": "object",
  "required": [
    "repo",
    "forge",
    "sha",
    "audited_at",
    "category",
    "honesty",
    "h3_scope",
    "risk",
    "verdict",
    "evidence_max",
    "coverage",
    "verification",
    "git_depth",
    "disclosure",
    "status",
    "language",
    "headline_en",
    "headline_zh",
    "tags"
  ],
  "properties": {
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "forge": {
      "type": "string",
      "enum": ["github", "gitlab", "codeberg"]
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "supersedes_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "translation_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{7,12}\\.md$"
    },
    "audited_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "coding-agent",
        "autonomous-agent",
        "local-llm-runtime",
        "ai-webui",
        "ai-workflow",
        "browser-agent",
        "credential-switcher",
        "model-proxy",
        "desktop-client",
        "mcp-server",
        "dev-tool",
        "other"
      ]
    },
    "honesty": {
      "type": "string",
      "enum": ["H0", "H1", "H2", "H3", "H4", "Insufficient Evidence"]
    },
    "h3_scope": {
      "type": "string",
      "enum": ["primary", "edge", "mixed", "none"]
    },
    "risk": {
      "type": "string",
      "enum": ["R0", "R1", "R2", "R3", "R4", "Insufficient Evidence"]
    },
    "verdict": {
      "type": "string",
      "enum": ["Adopt", "Adopt with Config", "Isolate", "Avoid"]
    },
    "evidence_max": {
      "type": "string",
      "enum": ["E3+D", "E3", "E2", "E1", "E0"]
    },
    "coverage": {
      "type": "string",
      "enum": ["full-exhaustive", "lead-driven", "package-scoped"]
    },
    "verification": {
      "type": "string",
      "enum": ["static", "static+release-diff", "static+dynamic", "static+release-diff+dynamic"]
    },
    "git_depth": {
      "oneOf": [
        {"type": "string", "enum": ["full"]},
        {"type": "integer", "minimum": 1}
      ]
    },
    "disclosure": {
      "type": "string",
      "enum": ["public", "partially-redacted", "embargoed"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "superseded", "remediated", "disputed"]
    },
    "language": {
      "type": "string",
      "enum": ["en", "zh-CN"]
    },
    "headline_en": {
      "type": "string",
      "minLength": 15,
      "maxLength": 140
    },
    "headline_zh": {
      "type": "string",
      "minLength": 8,
      "maxLength": 90
    },
    "companion_repos": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+=(github|gitlab|codeberg):[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@[0-9a-f]{40}$"
      }
    },
    "upstream_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(open|acknowledged|fixed|wontfix|existing)\\|https://[^|\\s]+\\|.{3,160}$"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    }
  }
}
